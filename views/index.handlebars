<!DOCTYPE html>
<html lang="pt-BR">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Instância {{instanceId}}</title>
  <style>
    body {
      font-family: Arial, Helvetica, sans-serif;

      display: flex;
      justify-content: center;
      align-items: center;
      height: 100vh;
      margin: 0;
    }

    .card {
      background: #ffffff;
      padding: 40px;
      border-radius: 12px;
      box-shadow: 0 8px 20px rgba(0, 0, 0, 0.25);
      text-align: center;
      min-width: 320px;
    }

    h2 {
      margin-top: 0;
      color: #333333;
      font-size: 1.2rem;
      text-transform: uppercase;
      letter-spacing: 1px;
    }

    .badge {
      font-size: 2rem;
      font-weight: bold;
      color: #e9e5e5;

      background-color: #494747;
      padding: 12px 24px;
      border-radius: 8px;
      display: inline-block;
      margin: 15px 0;
    }

    .info {
      color: #161616;
      font-size: 0.95rem;
      line-height: 1.4;
    }
  </style>
</head>

<body>
  <div class="card">
    <h2>Respondido por:</h2>
    <div class="badge">{{instanceId}}</div>
    <p class="info">
      <strong>Horário (São Paulo):</strong><br>
      {{timestamp}}
    </p>
  </div>
</body>

</html>